<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity wrapper HoverHereNative.cs (the same files that Unity compiles, C# 9, without UnityEngine) and checks it against the
       real hoverhere library: struct layout of every member, coordinate conversions and a short simulation through the P/Invoke interface. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\HoverHere\Assets\Scripting\Native\HoverHereNative.cs" Link="Native\HoverHereNative.cs" />
    <Compile Include="..\..\..\..\HoverHere\Assets\Scripting\Native\HoverHereNative.Structs.g.cs" Link="Native\HoverHereNative.Structs.g.cs" />
  </ItemGroup>

</Project>
